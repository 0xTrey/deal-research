# Apollo API - Get from https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your-apollo-api-key-here

# Deal-research bootstrap exports both AI_GEMINI_KEY and GEMINI_API_KEY
# from the dedicated keychain secret gemini-deal-research-api.
GEMINI_API_KEY=your-gemini-api-key-here

# Tavily API - Get from https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Brave Search API - Get from https://brave.com/search/api/
BRAVE_API_KEY=your-brave-api-key-here

# Perplexity Search API - Get from https://docs.perplexity.ai
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Synthesis fallback chain used by llm-gateway
AI_DEEPSEEK_KEY=your-deepseek-api-key-here
AI_OPENAI_KEY=your-openai-api-key-here

# Google Drive folder ID for storing research docs
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# Shared Google Workspace auth profile
GOOGLE_WORKSPACE_CONFIG=~/.config/google-workspace-folloze
GOOGLE_WORKSPACE_PATH=~/Projects/Folloze-Sales-Stack/projects/google-workspace

# Optional alert override for runner/bootstrap
DEAL_RESEARCH_ALERT_EMAIL=trey.harnden@folloze.com
